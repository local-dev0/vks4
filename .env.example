# --- общие ---
ENV=dev                              # dev | staging | prod
LOG_LEVEL=info
PUBLIC_HOST=localhost
PUBLIC_URL=https://localhost

# --- Postgres ---
POSTGRES_USER=vks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vks
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://vks:change-me@postgres:5432/vks?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=recordings
MINIO_USE_SSL=false

# --- JWT ---
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=vks4
JWT_AUDIENCE=vks4-admin

# Bootstrap admin (seed migration)
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=admin

# --- gRPC endpoints ---
MEDIA_ROUTER_GRPC=media-router:9090
MEDIA_WORKER_GRPC=media-worker:9091
SIGNALING_GRPC=signaling:9092
CONTROL_PLANE_GRPC=control-plane:9093

# --- HTTP listeners ---
CONTROL_PLANE_HTTP=:8080
SIGNALING_HTTP=:8081
ADMIN_WEB_HTTP=:8082
PROMETHEUS_HTTP=:9100

# --- ICE / TURN ---
STUN_URLS=stun:coturn:3478
TURN_URLS=turn:coturn:3478?transport=udp
TURN_USERNAME=vks
TURN_PASSWORD=change-me-turn
TURN_REALM=vks4.local

# --- Media worker ---
MEDIA_WORKER_ID=worker-1
MEDIA_WORKER_VIDEO_BITRATE=2500000
MEDIA_WORKER_AUDIO_BITRATE=64000
MEDIA_WORKER_VIDEO_WIDTH=1280
MEDIA_WORKER_VIDEO_HEIGHT=720
MEDIA_WORKER_VIDEO_FPS=30
MEDIA_WORKER_VIDEO_CODEC=vp8           # vp8 | h264
MEDIA_WORKER_MODE_SFU=true             # smoke режим: RTP forward без mixing
# Публичный IP сервера — подставляется в ICE-кандидаты Pion как host (1:1 NAT)
MEDIA_WORKER_PUBLIC_IP=
MEDIA_WORKER_UDP_MIN=50000
MEDIA_WORKER_UDP_MAX=50050

# --- Recording ---
RECORDING_ENABLED=true
RECORDING_DIR=/data/recordings
RECORDING_S3_ENABLED=true

# --- FreeSWITCH ESL ---
FS_ESL_HOST=freeswitch
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
