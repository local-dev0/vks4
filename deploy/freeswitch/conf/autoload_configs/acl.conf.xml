<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <!-- ACL для ESL: разрешаем все docker-bridge подсети (172.16.0.0/12) + loopback.
         Production: ужесточить до конкретной CIDR. -->
    <list name="docker-net" default="deny">
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="127.0.0.0/8"/>
    </list>
  </network-lists>
</configuration>
