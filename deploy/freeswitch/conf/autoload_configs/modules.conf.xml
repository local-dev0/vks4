<configuration name="modules.conf" description="Modules">
  <modules>
    <!-- Минимальный набор для SIP edge: sofia (SIP transport), conference не нужен — мы свой MCU. -->
    <load module="mod_console"/>
    <load module="mod_logfile"/>
    <load module="mod_event_socket"/>
    <load module="mod_commands"/>
    <load module="mod_dptools"/>
    <load module="mod_dialplan_xml"/>
    <load module="mod_sofia"/>
    <load module="mod_loopback"/>
    <load module="mod_hash"/>
    <!-- Кодеки -->
    <load module="mod_opus"/>
    <load module="mod_g711"/>
    <load module="mod_g722"/>
    <!-- mod_av даёт реальный libav-based H.264 encoder/decoder для bypass_media=false режима.
         mod_h26x загружать НЕ нужно (он регистрирует H.264 как passthru, что используется только
         в proxy_media режиме; рядом с mod_av он перекрывает кодек выбор и ломает negotiation). -->
    <load module="mod_av"/>
    <load module="mod_sndfile"/>
    <load module="mod_native_file"/>
    <load module="mod_tone_stream"/>
  </modules>
</configuration>
