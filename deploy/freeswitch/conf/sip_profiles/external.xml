<profile name="external">
  <!-- External SIP profile: принимает звонки от любых SIP-терминалов на UDP 5060.
       В первой итерации без auth (anonymous calls разрешены) — для упрощения настройки
       тестового terminal'а. Production: накатить SIP digest auth + ACL. -->
  <settings>
    <param name="user-agent-string" value="vks4-sip-edge"/>
    <param name="sip-port" value="5060"/>
    <param name="sip-ip" value="0.0.0.0"/>
    <param name="rtp-ip" value="0.0.0.0"/>

    <!-- ext-* для SDP: публичный IP хоста (см. vars.xml: external_ip из env SOFIA_EXTERNAL_IP).
         "auto" не подходит — FS в docker детектит свой internal IP (172.x), недостижимый
         для SIP-терминалов в LAN. Терминал получает этот IP в c-line и шлёт RTP в никуда. -->
    <param name="ext-rtp-ip" value="$${external_ip}"/>
    <param name="ext-sip-ip" value="$${external_ip}"/>

    <param name="context" value="public"/>

    <param name="auth-calls" value="false"/>
    <param name="accept-blind-auth" value="true"/>
    <param name="accept-blind-reg" value="false"/>

    <!-- Все кодеки в одном списке. FS строит channel->codecs из этого списка
         (audio + video в одну mparams->codecs[]), и без видео-кодека здесь не выставляется
         CF_VIDEO_POSSIBLE → outbound INVITE не получает m=video. -->
    <param name="inbound-codec-prefs" value="OPUS,PCMA,PCMU,H264"/>
    <param name="outbound-codec-prefs" value="OPUS,PCMA,PCMU,H264"/>
    <param name="inbound-video-codec-prefs" value="H264"/>
    <param name="outbound-video-codec-prefs" value="H264"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="inbound-late-negotiation" value="false"/>

    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>

    <param name="enable-100rel" value="true"/>
    <param name="disable-srv" value="true"/>
    <param name="disable-naptr" value="true"/>
  </settings>
  <gateways>
    <X-PRE-PROCESS cmd="include" data="external/*.xml"/>
  </gateways>
</profile>
